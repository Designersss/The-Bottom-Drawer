# Keep Unity YAML and C# diffable.
*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Do not corrupt raster, audio or packaged game data.
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
